OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-5.4-mini
NEXO_MAX_OUTPUT_TOKENS=900
NEXO_REASONING_EFFORT=low
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-client-secret
MERCADO_PAGO_PUBLIC_KEY=APP_USR-your-public-key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-your-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-signature-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=LIVE
PAYPAL_CURRENCY_CODE=BRL
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://ansendmusic.site/api/spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-secret
